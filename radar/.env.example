# --- Core infra ---
DATABASE_URL=postgres://radar:radar@localhost:5432/radar
REDIS_URL=redis://localhost:6379

# --- AI (enrichment + proposal rewriting + execution) ---
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini          # cheap for enrichment; upgrade for drafting

# --- Image generation (execution engine, optional) ---
HIGGSFIELD_API_KEY=               # set => landing hero uses a real generated image
HIGGSFIELD_URL=https://api.higgsfield.ai/v1/images

# --- Outbound delivery / outreach ---
RESEND_API_KEY=                    # transactional email for digests/outreach
RESEND_FROM=RadarPL <onboarding@resend.dev>
SLACK_WEBHOOK_URL=
RADAR_WEBHOOK_URL=                 # generic webhook sink for approved outreach

# --- Billing (Stripe) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=          # price id -> plan STARTER (49 zł)
STRIPE_PRICE_PRO=              # -> PRO (149 zł)
STRIPE_PRICE_AGENCY=          # -> AGENCY (499 zł)
APP_URL=http://localhost:3000

# --- n8n ---
N8N_USER=admin
N8N_PASSWORD=changeme

# --- Crawl politeness ---
CRAWL_USER_AGENT=RadarPL/0.1 (+https://radar.pl/bot)
CRAWL_CONCURRENCY=4
CRAWL_MIN_DELAY_MS=1500
