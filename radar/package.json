{
  "name": "radar",
  "version": "0.1.0",
  "private": true,
  "description": "RadarPL — silnik sygnałów popytu z publicznych danych (lead-gen as a service, sterowany AI).",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "test": "pnpm -r --if-present test",
    "test:core": "pnpm --filter @radar/core test",
    "test:agent": "node --test agent/test/cycle.test.ts agent/test/outreach.test.ts agent/test/learn.test.ts agent/test/crawl.test.ts agent/test/repo.test.ts agent/test/billing.test.ts agent/test/onboarding.test.ts agent/test/execute.test.ts",
    "test:exec": "node --test agent/exec/test/engine.test.ts",
    "agent:execute": "node agent/cli.ts execute",
    "typecheck": "pnpm -r --if-present typecheck",
    "dev": "docker compose up -d && pnpm --filter @radar/web dev",
    "db:migrate": "prisma migrate dev",
    "db:generate": "prisma generate",
    "agent:once": "node agent/cli.ts once",
    "agent:loop": "node agent/cli.ts loop",
    "agent:status": "node agent/cli.ts status",
    "agent:leads": "node agent/cli.ts leads",
    "test:mcp": "node --test agent/mcp/test/mcp.test.ts",
    "mcp": "node agent/mcp/server.ts"
  },
  "devDependencies": {
    "prisma": "^5.20.0",
    "typescript": "^5.6.0"
  }
}
